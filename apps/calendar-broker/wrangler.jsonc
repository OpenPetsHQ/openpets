{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openpets-calendar-broker",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "CALENDAR_CONNECT_DB",
      "database_name": "openpets-calendar-connect",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "PROFILE_RATE_LIMITER",
      "namespace_id": "9020401",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "9020402",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "LINK_RATE_LIMITER",
      "namespace_id": "9020403",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
