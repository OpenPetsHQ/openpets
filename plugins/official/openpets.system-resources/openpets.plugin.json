{
  "manifestVersion": 3,
  "id": "openpets.system-resources",
  "name": "$t:plugin.name",
  "description": "$t:plugin.description",
  "version": "2.1.0",
  "runtime": "javascript",
  "icon": "plugin",
  "sdkVersion": "3.0.0",
  "entry": "index.js",
  "assets": {
    "icons": {
      "system-resources": "assets/system-resources.svg",
      "cpu": "assets/cpu.svg",
      "ram": "assets/ram.svg",
      "gpu": "assets/gpu.svg",
      "disk": "assets/disk.svg"
    }
  },
  "permissions": [
    "pet:speak",
    "pet:reaction",
    "pet:pin",
    "schedule",
    "storage",
    "commands",
    "status",
    "events",
    "system:metrics"
  ],
  "configSchema": {
    "language": {
      "type": "select",
      "default": "auto",
      "label": "$t:config.language.label",
      "description": "$t:config.language.description",
      "options": [
        { "value": "auto", "label": "$t:config.language.auto" },
        { "value": "nl", "label": "$t:config.language.nl" },
        { "value": "en", "label": "$t:config.language.en" },
        { "value": "fr", "label": "$t:config.language.fr" },
        { "value": "de", "label": "$t:config.language.de" }
      ]
    },
    "showHud": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.showHud.label",
      "description": "$t:config.showHud.description"
    },
    "showCpu": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.showCpu.label",
      "description": "$t:config.showCpu.description"
    },
    "showRam": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.showRam.label",
      "description": "$t:config.showRam.description"
    },
    "showGpu": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.showGpu.label",
      "description": "$t:config.showGpu.description"
    },
    "showDisk": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.showDisk.label",
      "description": "$t:config.showDisk.description"
    },
    "showBattery": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.showBattery.label",
      "description": "$t:config.showBattery.description"
    },
    "showNetwork": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.showNetwork.label",
      "description": "$t:config.showNetwork.description"
    },
    "pollSeconds": {
      "type": "number",
      "default": 10,
      "min": 5,
      "max": 60,
      "label": "$t:config.pollSeconds.label",
      "description": "$t:config.pollSeconds.description"
    },
    "alertPercent": {
      "type": "number",
      "default": 90,
      "min": 70,
      "max": 99,
      "label": "$t:config.alertPercent.label",
      "description": "$t:config.alertPercent.description"
    },
    "alertCpu": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.alertCpu.label",
      "description": "$t:config.alertCpu.description"
    },
    "alertRam": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.alertRam.label",
      "description": "$t:config.alertRam.description"
    },
    "alertGpu": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.alertGpu.label",
      "description": "$t:config.alertGpu.description"
    },
    "alertDisk": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.alertDisk.label",
      "description": "$t:config.alertDisk.description"
    },
    "speakAlerts": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.speakAlerts.label",
      "description": "$t:config.speakAlerts.description"
    }
  }
}
