{
  "manifestVersion": 3,
  "id": "openpets.anxiety-aid-tools",
  "name": "$t:plugin.name",
  "description": "$t:plugin.description",
  "version": "0.1.0",
  "runtime": "javascript",
  "icon": "heart",
  "sdkVersion": "3.0.0",
  "entry": "index.js",
  "assets": {
    "svgs": {
      "logo": "assets/logo.svg"
    },
    "sounds": {
      "breath-in": "assets/breath-in.mp3",
      "breath-out": "assets/breath-out.mp3"
    }
  },
  "permissions": ["ui:session", "commands", "storage"]
}
